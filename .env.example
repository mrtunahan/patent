# Backend (Uvicorn)
HOST=127.0.0.1
PORT=8001

# CORS: virgülle ayrılmış origin listesi. Production'da boş bırakın (aynı origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# iframe gömme: Content-Security-Policy frame-ancestors kaynakları (boşlukla ayrılmış).
# ';' ve satır sonu içeremez. X-Frame-Options gönderilmez.
FRAME_ANCESTORS="'self'"

# Reverse proxy alt yolu (backend). Boş = kök. Örn: /patent
# Varsayım: proxy prefix'i siler.
ROOT_PATH=

# Frontend alt yolu (build zamanında gömülür). Boş = kök. Örn: /patent/
VITE_BASE_PATH=
